<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        GST state codes: the first two digits of every GSTIN.
        Codes 25 (Daman and Diu) and 28 (undivided Andhra Pradesh) are not
        listed because they were withdrawn when those territories merged.
        Ladakh and Other Territory have no matching res.country.state in
        Odoo base, so they carry no link and are simply not cross-checked.
    -->

