<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_backup_log_list" model="ir.ui.view">
        <field name="name">drkds.backup.log.list</field>
        <field name="model">drkds.backup.log</field>
        <field name="arch" type="xml">
            <list string="Backup Runs" create="0" edit="0"
                  decoration-info="status == 'running'"
                  decoration-danger="status == 'failed'" decoration-muted="status == 'deleted'">
                <field name="date_start"/>
                <field name="config_id"/>
                <field name="name"/>
                <field name="backup_format"/>
                <field name="size_display"/>
                <field name="duration" optional="show"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'running'"
                       decoration-success="status == 'done'"
                       decoration-danger="status == 'failed'"
                       decoration-muted="status == 'deleted'"/>
                <field name="message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_backup_log_form" model="ir.ui.view">
        <field name="name">drkds.backup.log.form</field>
        <field name="model">drkds.backup.log</field>
        <field name="arch" type="xml">
            <form string="Backup Run" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="status" widget="badge"
                                   decoration-info="status == 'running'"
                                   decoration-success="status == 'done'"
                                   decoration-danger="status == 'failed'"
                                   decoration-muted="status == 'deleted'"/>
                            <field name="path"/>
                            <field name="file_exists"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="duration"/>
                            <field name="backup_format"/>
                            <field name="size_display"/>
                        </group>
                    </group>
                    <group string="Message" invisible="not message">
                        <field name="message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_backup_log_search" model="ir.ui.view">
        <field name="name">drkds.backup.log.search</field>
        <field name="model">drkds.backup.log</field>
        <field name="arch" type="xml">
            <search string="Backup Runs">
                <field name="name"/>
                <field name="config_id"/>
                <field name="message"/>
                <filter name="running" string="Running" domain="[('status', '=', 'running')]"/>
                <filter name="done" string="Done" domain="[('status', '=', 'done')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="deleted" string="File Removed" domain="[('status', '=', 'deleted')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date_start', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group name="group_by">
                    <filter name="group_config" string="Configuration" context="{'group_by': 'config_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date_start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_drkds_backup_log" model="ir.actions.act_window">
        <field name="name">Backup Runs</field>
        <field name="res_model">drkds.backup.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drkds_backup_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No backup has run yet</p>
            <p>Every run, successful or not, is listed here with its file, size and duration.</p>
        </field>
    </record>

</odoo>
