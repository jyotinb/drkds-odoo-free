<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_backup_config_list" model="ir.ui.view">
        <field name="name">drkds.backup.config.list</field>
        <field name="model">drkds.backup.config</field>
        <field name="arch" type="xml">
            <list string="Backup Configurations">
                <field name="name"/>
                <field name="folder"/>
                <field name="backup_format"/>
                <field name="keep_last"/>
                <field name="interval_number" string="Every"/>
                <field name="interval_type"/>
                <field name="nextcall"/>
                <field name="last_run"/>
                <field name="last_status" widget="badge"
                       decoration-info="last_status == 'running'"
                       decoration-success="last_status in ('done', 'deleted')"
                       decoration-danger="last_status == 'failed'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_backup_config_form" model="ir.ui.view">
        <field name="name">drkds.backup.config.form</field>
        <field name="model">drkds.backup.config</field>
        <field name="arch" type="xml">
            <form string="Backup Configuration">
                <header>
                    <button name="action_backup_now" type="object" string="Backup Now"
                            class="btn-primary"
                            confirm="Run this backup now? A large database can take a few minutes."/>
                    <button name="action_test_folder" type="object" string="Test Folder"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button"
                                icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Runs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Nightly backup"/></h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="db_name"/>
                            <field name="folder" placeholder="/var/backups/odoo"/>
                            <field name="backup_format"/>
                            <field name="keep_last"/>
                        </group>
                        <group string="Schedule">
                            <label for="interval_number"/>
                            <div class="o_row">
                                <field name="interval_number"/>
                                <field name="interval_type"/>
                            </div>
                            <field name="nextcall"/>
                            <field name="last_run"/>
                            <field name="last_status" widget="badge"
                                   decoration-info="last_status == 'running'"
                                   decoration-success="last_status in ('done', 'deleted')"
                                   decoration-danger="last_status == 'failed'"/>
                        </group>
                    </group>
                    <group string="On failure">
                        <field name="notify_user_ids" widget="many2many_tags" nolabel="1" colspan="2"
                               options="{'no_create': True}"
                               placeholder="Administrators who get a to-do when a run fails"/>
                    </group>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="cron_id" groups="base.group_no_one"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_drkds_backup_config_search" model="ir.ui.view">
        <field name="name">drkds.backup.config.search</field>
        <field name="model">drkds.backup.config</field>
        <field name="arch" type="xml">
            <search string="Backup Configurations">
                <field name="name"/>
                <field name="folder"/>
                <filter name="zip" string="Zip" domain="[('backup_format', '=', 'zip')]"/>
                <filter name="dump" string="Dump" domain="[('backup_format', '=', 'dump')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_format" string="Format" context="{'group_by': 'backup_format'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_drkds_backup_config" model="ir.actions.act_window">
        <field name="name">Backup Configurations</field>
        <field name="res_model">drkds.backup.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drkds_backup_config_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up a scheduled backup</p>
            <p>Name a folder on the server, choose a format and how many copies to keep,
               and Odoo dumps the database on the schedule you set.</p>
        </field>
    </record>

</odoo>
