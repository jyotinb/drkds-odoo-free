<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_knowledge_base" model="res.groups.privilege">
        <field name="name">Knowledge Base</field>
        <field name="description">Who may read articles and who may write them.</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_kb_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_knowledge_base"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can read published articles and keep personal bookmarks.</field>
    </record>

    <record id="group_kb_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_knowledge_base"/>
        <field name="implied_ids" eval="[(4, ref('group_kb_reader'))]"/>
        <field name="comment">Can write articles, manage sections and tags, and see drafts.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Readers see published articles only; a draft is an editor's workbench. -->
    <record id="rule_kb_article_reader" model="ir.rule">
        <field name="name">Knowledge Base: readers see published articles</field>
        <field name="model_id" ref="model_drkds_lite_kb_article"/>
        <field name="domain_force">[('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('group_kb_reader'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_kb_article_editor" model="ir.rule">
        <field name="name">Knowledge Base: editors see every article</field>
        <field name="model_id" ref="model_drkds_lite_kb_article"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_kb_editor'))]"/>
    </record>

    <!-- A bookmark is private to the user who made it. -->
    <record id="rule_kb_favourite_own" model="ir.rule">
        <field name="name">Knowledge Base: own bookmarks only</field>
        <field name="model_id" ref="model_drkds_kb_favourite"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_kb_reader'))]"/>
    </record>

</odoo>
