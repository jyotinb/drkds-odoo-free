<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="rule_drkds_hr_document_company" model="ir.rule">
        <field name="name">Employee documents: multi-company</field>
        <field name="model_id" ref="model_drkds_hr_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_drkds_hr_document_type_company" model="ir.rule">
        <field name="name">Employee document types: multi-company</field>
        <field name="model_id" ref="model_drkds_hr_document_type"/>
        <field name="domain_force">['|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
