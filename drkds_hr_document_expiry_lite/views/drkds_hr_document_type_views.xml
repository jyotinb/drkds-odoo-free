<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_hr_document_type_list" model="ir.ui.view">
        <field name="name">drkds.hr.document.type.list</field>
        <field name="model">drkds.hr.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="requires_expiry"/>
                <field name="remind_days"/>
                <field name="mandatory"/>
                <field name="document_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_hr_document_type_form" model="ir.ui.view">
        <field name="name">drkds.hr.document.type.form</field>
        <field name="model">drkds.hr.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object" class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Passport"/></h1>
                    </div>
                    <group>
                        <group string="Expiry">
                            <field name="requires_expiry"/>
                            <field name="remind_days" invisible="not requires_expiry"/>
                        </group>
                        <group string="Rules">
                            <field name="mandatory"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="What this document is and who issues it."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_hr_document_type_search" model="ir.ui.view">
        <field name="name">drkds.hr.document.type.search</field>
        <field name="model">drkds.hr.document.type</field>
        <field name="arch" type="xml">
            <search string="Document Types">
                <field name="name"/>
                <filter name="mandatory" string="Mandatory" domain="[('mandatory', '=', True)]"/>
                <filter name="requires_expiry" string="With Expiry" domain="[('requires_expiry', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_drkds_hr_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">drkds.hr.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drkds_hr_document_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a document type</p>
            <p>
                A type says whether the document expires, how many days ahead
                HR is reminded, and whether every employee must hold one.
            </p>
        </field>
    </record>

</odoo>
