<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_hr_document_list" model="ir.ui.view">
        <field name="name">drkds.hr.document.list</field>
        <field name="model">drkds.hr.document</field>
        <field name="arch" type="xml">
            <list string="Employee Documents"
                  decoration-warning="state == 'expiring'"
                  decoration-danger="state == 'expired'">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="type_id"/>
                <field name="number" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_hr_document_form" model="ir.ui.view">
        <field name="name">drkds.hr.document.form</field>
        <field name="model">drkds.hr.document</field>
        <field name="arch" type="xml">
            <form string="Employee Document">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" placeholder="Document"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date" required="requires_expiry"/>
                            <field name="days_to_expiry" invisible="not expiry_date"/>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="requires_expiry" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Anything HR should know about this document."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_drkds_hr_document_search" model="ir.ui.view">
        <field name="name">drkds.hr.document.search</field>
        <field name="model">drkds.hr.document</field>
        <field name="arch" type="xml">
            <search string="Employee Documents">
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="number"/>
                <filter name="valid" string="Valid" domain="[('state', '=', 'valid')]"/>
                <filter name="expiring" string="Expiring" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="expiry_date" string="Expiry Date" date="expiry_date"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_expiry_month" string="Expiry Month" context="{'group_by': 'expiry_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_drkds_hr_document_activity" model="ir.ui.view">
        <field name="name">drkds.hr.document.activity</field>
        <field name="model">drkds.hr.document</field>
        <field name="arch" type="xml">
            <activity string="Employee Documents">
                <templates>
                    <div t-name="activity-box">
                        <div>
                            <field name="name" display="full" class="o_text_block"/>
                            <field name="expiry_date" muted="1" display="full"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="action_drkds_hr_document" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">drkds.hr.document</field>
        <field name="view_mode">list,form,activity</field>
        <field name="search_view_id" ref="view_drkds_hr_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an employee document</p>
            <p>
                Pick the employee and the type, enter the dates and attach the
                scan. The status follows the expiry date on its own.
            </p>
        </field>
    </record>

</odoo>
