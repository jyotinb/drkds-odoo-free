<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 gives wizard records no protection of their own: each one
         is kept to the user who opened it. -->
    <record id="drkds_fy_range_builder_creator_only" model="ir.rule">
        <field name="name">Financial Year Range Builder: only its creator</field>
        <field name="model_id" ref="model_drkds_fy_range_builder"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
