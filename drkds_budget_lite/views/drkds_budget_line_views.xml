<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_budget_line_report_list" model="ir.ui.view">
        <field name="name">drkds.lite.budget.line.report.list</field>
        <field name="model">drkds.lite.budget.line</field>
        <field name="arch" type="xml">
            <list string="Budget vs Actual" create="false" edit="false"
                  decoration-danger="is_over_budget">
                <field name="budget_id"/>
                <field name="date_from" string="From" optional="show"/>
                <field name="date_to" string="To" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="account_id"/>
                <field name="account_group_id" optional="show"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="budget_direction" optional="show"/>
                <field name="planned_amount"/>
                <field name="actual_amount"/>
                <field name="variance_amount"/>
                <field name="variance_percent" string="Variance %"/>
                <field name="achieved_percent" string="Achieved %" widget="progressbar"/>
                <field name="state" widget="badge" optional="hide"/>
                <button name="action_open_move_lines" type="object" string="Journal Items"
                        icon="fa-search-plus" title="Show the posted journal items behind this figure"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_budget_line_form" model="ir.ui.view">
        <field name="name">drkds.lite.budget.line.form</field>
        <field name="model">drkds.lite.budget.line</field>
        <field name="arch" type="xml">
            <form string="Budget Line">
                <sheet>
                    <group>
                        <group>
                            <field name="budget_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="account_id" readonly="account_group_id != False"/>
                            <field name="account_group_id" readonly="account_id != False"/>
                            <field name="analytic_account_id"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="budget_direction"/>
                            <field name="planned_amount"/>
                            <field name="actual_amount"/>
                            <field name="variance_amount"/>
                            <field name="variance_percent"/>
                            <field name="is_over_budget"/>
                        </group>
                    </group>
                    <div class="mt-3">
                        <button name="action_open_move_lines" type="object" class="btn-secondary"
                                string="Journal Items" icon="fa-search-plus"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_budget_line_search" model="ir.ui.view">
        <field name="name">drkds.lite.budget.line.search</field>
        <field name="model">drkds.lite.budget.line</field>
        <field name="arch" type="xml">
            <search string="Budget vs Actual">
                <field name="budget_id"/>
                <field name="account_id"/>
                <field name="account_group_id"/>
                <field name="analytic_account_id"/>
                <filter name="state_confirmed" string="Confirmed Budgets"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_done" string="Done Budgets" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="direction_expense" string="Expense"
                        domain="[('budget_direction', '=', 'expense')]"/>
                <filter name="direction_income" string="Income"
                        domain="[('budget_direction', '=', 'income')]"/>
                <separator/>
                <filter name="period_start" string="Period Start" date="date_from"/>
                <group name="group_by">
                    <filter name="group_by_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_by_group" string="Account Group"
                            context="{'group_by': 'account_group_id'}"/>
                    <filter name="group_by_analytic" string="Analytic Account"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_by_budget" string="Budget" context="{'group_by': 'budget_id'}"/>
                    <filter name="group_by_direction" string="Direction"
                            context="{'group_by': 'budget_direction'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_drkds_budget_line_report" model="ir.actions.act_window">
        <field name="name">Budget vs Actual</field>
        <field name="res_model">drkds.lite.budget.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drkds_budget_line_search"/>
        <field name="domain">[('state', 'in', ['confirmed', 'done'])]</field>
        <field name="context">{'search_default_group_by_account': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to report yet</p>
            <p>
                Confirm a budget and its lines appear here, with the posted actuals
                and the variance. Use the magnifier on a line to open the journal
                items behind the figure.
            </p>
        </field>
    </record>

</odoo>
