<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_budget_list" model="ir.ui.view">
        <field name="name">drkds.budget.list</field>
        <field name="model">drkds.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" decoration-muted="state == 'cancel'" decoration-bf="state == 'confirmed'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="planned_total"/>
                <field name="actual_total"/>
                <field name="variance_total" decoration-danger="variance_total &lt; 0"/>
                <field name="over_budget_line_count" string="Over" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_budget_form" model="ir.ui.view">
        <field name="name">drkds.budget.form</field>
        <field name="model">drkds.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. FY 2026-27 Operating Budget"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from" readonly="state in ('confirmed', 'done')"/>
                            <field name="date_to" readonly="state in ('confirmed', 'done')"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="line_ids != []"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines" name="lines">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom" decoration-danger="is_over_budget">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="account_id"
                                           readonly="account_group_id != False"/>
                                    <field name="account_group_id"
                                           readonly="account_id != False" optional="show"/>
                                    <field name="analytic_account_id" optional="show"/>
                                    <field name="name" string="Description" optional="hide"/>
                                    <field name="budget_direction" optional="show"/>
                                    <field name="planned_amount"/>
                                    <field name="actual_amount"/>
                                    <field name="variance_amount"/>
                                    <field name="variance_percent" string="Variance %" widget="float"/>
                                    <field name="achieved_percent" string="Achieved %" widget="progressbar"/>
                                    <field name="is_over_budget" string="Over" widget="boolean_toggle" readonly="1"/>
                                    <button name="action_open_move_lines" type="object"
                                            icon="fa-search-plus" title="Journal Items"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="planned_total"/>
                                <field name="actual_total"/>
                                <field name="variance_total" class="oe_subtotal_footer_separator"/>
                                <field name="variance_percent"/>
                            </group>
                            <div class="clearfix"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Assumptions behind these figures..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_budget_search" model="ir.ui.view">
        <field name="name">drkds.budget.search</field>
        <field name="model">drkds.budget</field>
        <field name="arch" type="xml">
            <search string="Budgets">
                <field name="name"/>
                <field name="user_id"/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="running" string="Running Today"
                        domain="[('date_from', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="my_budgets" string="My Budgets"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="date_from_filter" string="Period Start" date="date_from"/>
                <group name="group_by">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_company" string="Company"
                            context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter name="group_by_date" string="Period Start" context="{'group_by': 'date_from'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_drkds_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">drkds.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drkds_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a budget</p>
            <p>
                Set a planned amount per account for a period, then watch the
                actual posted spend and the variance fill in by themselves.
            </p>
        </field>
    </record>

</odoo>
