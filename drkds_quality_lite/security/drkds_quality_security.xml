<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_drkds_quality_point_company" model="ir.rule">
        <field name="name">Quality point: multi-company</field>
        <field name="model_id" ref="model_drkds_quality_point"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_drkds_quality_check_company" model="ir.rule">
        <field name="name">Quality check: multi-company</field>
        <field name="model_id" ref="model_drkds_quality_check"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
