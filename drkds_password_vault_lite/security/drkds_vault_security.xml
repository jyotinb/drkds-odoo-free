<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Every rule below is global (no groups), so it applies to every
            user including the administrator. There is deliberately no
            "vault manager" group: a vault with an override group is not a
            personal vault.
        -->

        <record id="drkds_vault_entry_own_rule" model="ir.rule">
            <field name="name">Vault entry: owner only</field>
            <field name="model_id" ref="model_drkds_lite_vault_entry"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="drkds_vault_folder_own_rule" model="ir.rule">
            <field name="name">Vault folder: owner only</field>
            <field name="model_id" ref="model_drkds_vault_folder"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="drkds_vault_tag_own_rule" model="ir.rule">
            <field name="name">Vault tag: owner only</field>
            <field name="model_id" ref="model_drkds_lite_vault_tag"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="drkds_vault_access_log_own_rule" model="ir.rule">
            <field name="name">Vault access log: owner only</field>
            <field name="model_id" ref="model_drkds_lite_vault_access_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="drkds_vault_reveal_own_rule" model="ir.rule">
            <field name="name">Vault reveal wizard: owner only</field>
            <field name="model_id" ref="model_drkds_vault_reveal"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
