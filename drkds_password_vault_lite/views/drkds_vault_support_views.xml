<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="drkds_vault_folder_view_list" model="ir.ui.view">
        <field name="name">drkds.vault.folder.list</field>
        <field name="model">drkds.vault.folder</field>
        <field name="arch" type="xml">
            <list string="Folders" editable="bottom">
                <field name="name"/>
                <field name="entry_count" string="Entries"/>
            </list>
        </field>
    </record>

    <record id="drkds_vault_folder_action" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">drkds.vault.folder</field>
        <field name="view_mode">list</field>
    </record>

    <record id="drkds_vault_tag_view_list" model="ir.ui.view">
        <field name="name">drkds.lite.vault.tag.list</field>
        <field name="model">drkds.lite.vault.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="drkds_vault_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">drkds.lite.vault.tag</field>
        <field name="view_mode">list</field>
    </record>

    <record id="drkds_vault_access_log_view_list" model="ir.ui.view">
        <field name="name">drkds.lite.vault.access.log.list</field>
        <field name="model">drkds.lite.vault.access.log</field>
        <field name="arch" type="xml">
            <list string="Access Log" create="false" edit="false">
                <field name="create_date" string="When"/>
                <field name="entry_id"/>
                <field name="event"/>
                <field name="user_id"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="drkds_vault_access_log_action" model="ir.actions.act_window">
        <field name="name">Access Log</field>
        <field name="res_model">drkds.lite.vault.access.log</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
