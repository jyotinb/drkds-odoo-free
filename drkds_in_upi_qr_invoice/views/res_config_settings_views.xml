<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="drkds_upi_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.drkds.upi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='qr_code_invoices']" position="after">
                <setting id="drkds_upi_qr_invoices"
                         string="UPI Payment QR (India)"
                         company_dependent="1"
                         title="Print a scannable UPI QR code on posted customer invoices that still have an amount due."
                         help="Print a UPI QR code on customer invoices">
                    <div class="mt-2">
                        <div class="row mb-2">
                            <label for="drkds_upi_vpa" string="UPI ID (VPA)" class="col-lg-4 o_light_label"/>
                            <field name="drkds_upi_vpa" placeholder="acme@okhdfcbank"/>
                        </div>
                        <div class="row mb-2">
                            <label for="drkds_upi_payee_name" string="Payee Name" class="col-lg-4 o_light_label"/>
                            <field name="drkds_upi_payee_name" placeholder="Acme Industries"/>
                        </div>
                        <div>
                            <field name="drkds_upi_include_amount" class="me-2"/>
                            <label for="drkds_upi_include_amount" string="Pre-fill the amount due"/>
                        </div>
                        <div>
                            <field name="drkds_upi_include_reference" class="me-2"/>
                            <label for="drkds_upi_include_reference" string="Include the invoice reference"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
