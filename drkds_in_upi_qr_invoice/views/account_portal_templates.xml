<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="drkds_upi_portal_invoice_page"
              inherit_id="account.portal_invoice_page"
              name="UPI Payment QR on the portal invoice">
        <xpath expr="//div[hasclass('o_portal_html_view')]" position="before">
            <t t-set="drkds_upi_qr" t-value="invoice.sudo()._drkds_upi_qr_data_uri()"/>
            <div t-if="drkds_upi_qr" id="drkds_upi_portal_qrcode"
                 class="card mb-3">
                <div class="card-body d-flex align-items-center gap-3">
                    <img t-att-src="drkds_upi_qr" alt="UPI payment QR code"
                         style="width:120px;height:120px;"/>
                    <div>
                        <h5 class="mb-1">Pay by UPI</h5>
                        <p class="text-muted mb-1">
                            Scan this code with any UPI application to pay
                            <span t-field="invoice.amount_residual"/>.
                        </p>
                        <p class="mb-0 small">
                            UPI ID: <span t-out="invoice.sudo().company_id.drkds_upi_vpa"/>
                        </p>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
