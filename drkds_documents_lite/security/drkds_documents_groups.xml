<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_drkds_documents" model="res.groups.privilege">
        <field name="name">Document Folders</field>
        <field name="description">Who may file documents and who maintains the folders.</field>
        <field name="sequence">43</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_document_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_drkds_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the folders their groups allow and files documents in them.</field>
    </record>

    <record id="group_document_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_drkds_documents"/>
        <field name="implied_ids" eval="[(4, ref('group_document_user'))]"/>
        <field name="comment">Sees every folder and document, maintains folders, tags and mirroring.</field>
        <!-- The installing administrator gets the manager group so the app
             works the moment it is installed. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
