<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_document_add_wizard_form" model="ir.ui.view">
        <field name="name">drkds.document.add.wizard.form</field>
        <field name="model">drkds.document.add.wizard</field>
        <field name="arch" type="xml">
            <form string="Add to Documents">
                <group>
                    <field name="folder_id"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </group>
                <field name="attachment_ids">
                    <list>
                        <field name="name"/>
                        <field name="res_model"/>
                        <field name="res_name"/>
                        <field name="mimetype"/>
                        <field name="file_size"/>
                    </list>
                </field>
                <footer>
                    <button name="action_add" type="object" string="Add" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
