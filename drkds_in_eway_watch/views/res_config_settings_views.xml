<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_drkds_eway_watch" model="ir.ui.view">
        <field name="name">res.config.settings.form.drkds.eway.watch</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="E-Way Bill Watch (India)" name="drkds_eway_watch_setting_container">
                    <setting id="drkds_eway_threshold_setting"
                             string="E-Way Bill Threshold"
                             help="Value at or above which a posted customer document with no generated e-way bill is listed as a reminder.">
                        <field name="drkds_eway_threshold"/>
                    </setting>
                    <setting id="drkds_eway_km_setting"
                             string="Kilometres per Day of Validity"
                             help="Used only to suggest an expected expiry date. Rule 138(10): one day per 200 km or part thereof for regular cargo, 20 km for over dimensional cargo.">
                        <field name="drkds_eway_km_per_day"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
