<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_drkds_approvals" model="res.groups.privilege">
        <field name="name">Approval Requests</field>
        <field name="sequence">42</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_drkds_approvals"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Raises requests and decides on the categories they approve.</field>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_drkds_approvals"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        <field name="comment">Sees every request and maintains the categories.</field>
        <!-- The installing administrator gets the manager group so the app
             works the moment it is installed. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
