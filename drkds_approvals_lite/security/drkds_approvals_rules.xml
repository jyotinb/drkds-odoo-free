<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Own: requested by the user, or raised by them for someone else.
         To approve: submitted onwards in a category they approve; a draft
         stays with whoever is writing it. Decided: the user's decision stays
         visible after they leave the category. -->
    <record id="rule_approval_request_user" model="ir.rule">
        <field name="name">Approval requests: own and to approve</field>
        <field name="model_id" ref="model_drkds_approval_request"/>
        <field name="domain_force">['|', '|', '|',
            ('requester_id', '=', user.id),
            ('create_uid', '=', user.id),
            ('approver_id', '=', user.id),
            '&amp;', ('state', '!=', 'draft'), ('category_id.approver_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>

    <record id="rule_approval_request_manager" model="ir.rule">
        <field name="name">Approval requests: all</field>
        <field name="model_id" ref="model_drkds_approval_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <record id="rule_approval_request_company" model="ir.rule">
        <field name="name">Approval requests: multi-company</field>
        <field name="model_id" ref="model_drkds_approval_request"/>
        <field name="domain_force">['|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_approval_category_company" model="ir.rule">
        <field name="name">Approval categories: multi-company</field>
        <field name="model_id" ref="model_drkds_approval_category"/>
        <field name="domain_force">['|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
