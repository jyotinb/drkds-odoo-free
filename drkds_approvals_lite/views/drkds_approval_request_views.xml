<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_approval_request_kanban" model="ir.ui.view">
        <field name="name">drkds.approval.request.kanban</field>
        <field name="model">drkds.approval.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" records_draggable="false">
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="name" class="fw-bold"/>
                            <field name="date" class="ms-auto text-muted"/>
                        </div>
                        <field name="title" class="fw-bold fs-5"/>
                        <field name="category_id" class="text-muted"/>
                        <div t-if="record.amount.raw_value">
                            <field name="amount" widget="monetary"/>
                        </div>
                        <div class="d-flex mt-2 align-items-center">
                            <field name="activity_ids" widget="kanban_activity"/>
                            <field name="requester_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_drkds_approval_request_list" model="ir.ui.view">
        <field name="name">drkds.approval.request.list</field>
        <field name="model">drkds.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests">
                <field name="name"/>
                <field name="title"/>
                <field name="category_id"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="date"/>
                <field name="partner_id" optional="hide"/>
                <field name="amount" sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="approver_id" widget="many2one_avatar_user" optional="show"/>
                <field name="decision_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_approval_request_form" model="ir.ui.view">
        <field name="name">drkds.approval.request.form</field>
        <field name="model">drkds.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft' or not can_manage"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="not can_decide"/>
                    <button name="action_open_refuse_wizard" type="object" string="Refuse"
                            class="btn-secondary" invisible="not can_decide"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'submitted') or not can_manage"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state not in ('refused', 'cancelled') or not can_manage"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h2><field name="name"/></h2>
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Taxi fares, client visit"
                                   readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="requester_id" widget="many2one_avatar_user"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"
                                   required="require_partner and state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" readonly="state != 'draft'"
                                   required="require_amount and state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"
                                   groups="base.group_multi_currency"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                            <field name="approver_id" widget="many2one_avatar_user"
                                   invisible="not approver_id"/>
                            <field name="decision_date" invisible="not decision_date"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <!-- mirrors of the category, read by the required="" rules above,
                                 and the per-user flags the header buttons read -->
                            <field name="require_description" invisible="1"/>
                            <field name="require_amount" invisible="1"/>
                            <field name="require_partner" invisible="1"/>
                            <field name="can_decide" invisible="1"/>
                            <field name="can_manage" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="state != 'refused'">
                        <strong>Refused.</strong> <field name="refusal_reason" class="d-inline"/>
                    </div>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" readonly="state != 'draft'"
                                   placeholder="What is being asked for, and why."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_drkds_approval_request_search" model="ir.ui.view">
        <field name="name">drkds.approval.request.search</field>
        <field name="model">drkds.approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="name" string="Request"
                       filter_domain="['|', ('name', 'ilike', self), ('title', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="requester_id"/>
                <field name="approver_id"/>
                <field name="partner_id"/>
                <filter name="my_requests" string="My Requests" domain="[('requester_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve by Me"
                        domain="[('state', '=', 'submitted'), ('approver_ids', 'in', uid), ('requester_id', '!=', uid), ('create_uid', '!=', uid)]"/>
                <filter name="decided_by_me" string="Decided by Me" domain="[('approver_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'submitted'))]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="refused" string="Refused" domain="[('state', '=', 'refused')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_requester" string="Requester" context="{'group_by': 'requester_id'}"/>
                    <filter name="group_approver" string="Decided By" context="{'group_by': 'approver_id'}"/>
                    <filter name="group_date" string="Request Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_drkds_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">drkds.approval.request</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="view_drkds_approval_request_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Raise an approval request</p>
            <p>
                Pick a category, say what you need, submit. The approvers of the
                category get a to-do, and you get an email with their decision.
            </p>
        </field>
    </record>

    <record id="action_drkds_approval_request_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">drkds.approval.request</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="view_drkds_approval_request_search"/>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waits for your decision</p>
        </field>
    </record>

</odoo>
