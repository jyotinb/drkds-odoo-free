<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_approval_refuse_wizard_form" model="ir.ui.view">
        <field name="name">drkds.approval.refuse.wizard.form</field>
        <field name="model">drkds.approval.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Request">
                <group>
                    <field name="request_id"/>
                    <field name="reason" placeholder="Tell the requester why. This is emailed to them."/>
                </group>
                <footer>
                    <button name="action_refuse" type="object" string="Refuse" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
