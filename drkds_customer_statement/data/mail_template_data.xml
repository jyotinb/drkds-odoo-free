<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_drkds_statement" model="mail.template">
            <field name="name">Statement of Account: Send</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">{{ object.company_id.name or user.company_id.name }} Statement of Account - {{ object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or user.company_id.email_formatted or '') }}</field>
            <field name="partner_to">{{ object.id }}</field>
            <field name="description">Sent from the Statement wizard with the statement PDF attached.</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin:0px;padding:0px;font-size:13px;">
    <p>Dear <t t-out="object.name or ''">Customer</t>,</p>
    <p>
        Please find attached your statement of account
        <t t-if="ctx.get('drkds_date_from') and ctx.get('drkds_statement_type') != 'outstanding'">
            for the period <strong t-out="format_date(ctx.get('drkds_date_from')) or ''">2026-01-01</strong>
            to <strong t-out="format_date(ctx.get('drkds_date_to')) or ''">2026-01-31</strong>.
        </t>
        <t t-else="">
            as at <strong t-out="format_date(ctx.get('drkds_date_to')) or ''">2026-01-31</strong>.
        </t>
    </p>
    <p>
        If any item does not agree with your records, please let us know so
        we can resolve it promptly.
    </p>
    <p>Kind regards,<br/><t t-out="user.name or user.company_id.name or ''">Accounts</t></p>
</div>
            </field>
            <field name="lang">{{ object.lang }}</field>
        </record>

    </data>
</odoo>
