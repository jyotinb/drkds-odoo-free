<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_drkds_statement" model="ir.ui.view">
        <field name="name">res.config.settings.form.drkds.statement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="drkds_statement_setting"
                         string="Statement of Account"
                         help="Bank account and footer note printed on customer and vendor statements.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="drkds_statement_bank_id" class="col-lg-4 o_light_label"/>
                            <field name="drkds_statement_bank_id"/>
                        </div>
                        <div class="row">
                            <label for="drkds_statement_note" class="col-lg-4 o_light_label"/>
                            <field name="drkds_statement_note"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
