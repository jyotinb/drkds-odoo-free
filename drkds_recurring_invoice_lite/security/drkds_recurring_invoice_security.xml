<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_drkds_recurring_invoice_company" model="ir.rule">
            <field name="name">Recurring Invoice: multi-company</field>
            <field name="model_id" ref="model_drkds_recurring_invoice"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_drkds_recurring_invoice_line_company" model="ir.rule">
            <field name="name">Recurring Invoice Line: multi-company</field>
            <field name="model_id" ref="model_drkds_recurring_invoice_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
