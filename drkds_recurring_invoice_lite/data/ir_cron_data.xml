<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_drkds_recurring_invoice" model="ir.cron">
            <field name="name">Recurring Invoices: generate due invoices</field>
            <field name="model_id" ref="model_drkds_recurring_invoice"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_invoices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=1, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
