<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_drkds_recurring" model="ir.ui.view">
        <field name="name">account.move.form.drkds.recurring</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//field[@name='invoice_origin']" position="after">
                <field name="recurring_id" invisible="not recurring_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_drkds_recurring" model="ir.ui.view">
        <field name="name">account.move.search.drkds.recurring</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="recurring_id"/>
            </field>
        </field>
    </record>

</odoo>
