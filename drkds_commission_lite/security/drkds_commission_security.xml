<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_drkds_commission_rate_company" model="ir.rule">
            <field name="name">Commission Rate: multi-company</field>
            <field name="model_id" ref="model_drkds_commission_rate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_drkds_commission_line_company" model="ir.rule">
            <field name="name">Commission Line: multi-company</field>
            <field name="model_id" ref="model_drkds_commission_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- A salesperson sees only their own commission lines... -->
        <record id="rule_drkds_commission_line_own" model="ir.rule">
            <field name="name">Commission Line: own lines</field>
            <field name="model_id" ref="model_drkds_commission_line"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ...while sales and accounting managers see everyone's. -->
        <record id="rule_drkds_commission_line_all" model="ir.rule">
            <field name="name">Commission Line: all lines</field>
            <field name="model_id" ref="model_drkds_commission_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_manager'))]"/>
        </record>

        <record id="rule_drkds_commission_rate_own" model="ir.rule">
            <field name="name">Commission Rate: own rates</field>
            <field name="model_id" ref="model_drkds_commission_rate"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="rule_drkds_commission_rate_all" model="ir.rule">
            <field name="name">Commission Rate: all rates</field>
            <field name="model_id" ref="model_drkds_commission_rate"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_manager'))]"/>
        </record>

    </data>
</odoo>
