<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_commission_line_list" model="ir.ui.view">
        <field name="name">drkds.commission.line.list</field>
        <field name="model">drkds.commission.line</field>
        <field name="arch" type="xml">
            <list string="Commission Lines" create="false" edit="false"
                  decoration-success="state == 'paid'"
                  decoration-danger="amount &lt; 0">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            groups="sales_team.group_sale_manager,account.group_account_manager"/>
                    <button name="action_mark_unpaid" string="Mark as Unpaid" type="object"
                            groups="sales_team.group_sale_manager,account.group_account_manager"/>
                </header>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="move_id"/>
                <field name="move_type" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="categ_id" optional="hide"/>
                <field name="base_amount" sum="Base"/>
                <field name="rate"/>
                <field name="amount" sum="Commission"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"
                       decoration-warning="state == 'unpaid'"/>
                <field name="paid_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_commission_line_form" model="ir.ui.view">
        <field name="name">drkds.commission.line.form</field>
        <field name="model">drkds.commission.line</field>
        <field name="arch" type="xml">
            <form string="Commission Line" create="false">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid" type="object"
                            class="btn-primary" invisible="state != 'unpaid'"
                            groups="sales_team.group_sale_manager,account.group_account_manager"/>
                    <button name="action_mark_unpaid" string="Mark as Unpaid" type="object"
                            invisible="state != 'paid'"
                            groups="sales_team.group_sale_manager,account.group_account_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="move_id"/>
                            <field name="move_line_id"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="categ_id"/>
                            <field name="base_amount"/>
                            <field name="rate"/>
                            <field name="amount"/>
                            <!-- currency_id drives the monetary widgets and has no meaning of its own here -->
                            <field name="currency_id" invisible="1"/>
                            <field name="paid_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_commission_line_pivot" model="ir.ui.view">
        <field name="name">drkds.commission.line.pivot</field>
        <field name="model">drkds.commission.line</field>
        <field name="arch" type="xml">
            <pivot string="Commission by Salesperson and Month">
                <field name="user_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="base_amount" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_drkds_commission_line_graph" model="ir.ui.view">
        <field name="name">drkds.commission.line.graph</field>
        <field name="model">drkds.commission.line</field>
        <field name="arch" type="xml">
            <graph string="Commission" type="bar" stacked="True">
                <field name="date" interval="month"/>
                <field name="user_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_drkds_commission_line_search" model="ir.ui.view">
        <field name="name">drkds.commission.line.search</field>
        <field name="model">drkds.commission.line</field>
        <field name="arch" type="xml">
            <search string="Commission Lines">
                <field name="user_id"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <filter name="unpaid" string="Unpaid" domain="[('state', '=', 'unpaid')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="invoices" string="Invoices" domain="[('move_type', '=', 'out_invoice')]"/>
                <filter name="refunds" string="Credit Notes" domain="[('move_type', '=', 'out_refund')]"/>
                <separator/>
                <filter name="date" string="Invoice Date" date="date"/>
                <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_drkds_commission_line" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">drkds.commission.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_group_user': 1, 'search_default_group_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No commission yet</p>
            <p>
                Commission lines appear here when a customer invoice is posted
                for a salesperson who has a commission rate.
            </p>
        </field>
    </record>

</odoo>
