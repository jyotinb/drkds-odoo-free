<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_commission_rate_list" model="ir.ui.view">
        <field name="name">drkds.commission.rate.list</field>
        <field name="model">drkds.commission.rate</field>
        <field name="arch" type="xml">
            <list string="Commission Rates" editable="bottom">
                <field name="user_id"/>
                <field name="categ_id"/>
                <field name="rate"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_commission_rate_form" model="ir.ui.view">
        <field name="name">drkds.commission.rate.form</field>
        <field name="model">drkds.commission.rate</field>
        <field name="arch" type="xml">
            <form string="Commission Rate">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="categ_id"/>
                        <field name="rate"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_commission_rate_search" model="ir.ui.view">
        <field name="name">drkds.commission.rate.search</field>
        <field name="model">drkds.commission.rate</field>
        <field name="arch" type="xml">
            <search string="Commission Rates">
                <field name="user_id"/>
                <field name="categ_id"/>
                <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_drkds_commission_rate" model="ir.actions.act_window">
        <field name="name">Commission Rates</field>
        <field name="res_model">drkds.commission.rate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No category rate yet</p>
            <p>
                A rate here overrides the salesperson's default commission for
                products in that category and its sub-categories. Without one,
                the default rate on the user form applies to everything.
            </p>
        </field>
    </record>

</odoo>
