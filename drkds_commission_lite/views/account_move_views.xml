<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_drkds_commission" model="ir.ui.view">
        <field name="name">account.move.form.drkds.commission</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_drkds_commission_lines" type="object"
                        class="oe_stat_button" icon="fa-percent"
                        invisible="drkds_commission_line_count == 0"
                        groups="sales_team.group_sale_salesman,account.group_account_invoice">
                    <field name="drkds_commission_line_count" widget="statinfo" string="Commission"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
