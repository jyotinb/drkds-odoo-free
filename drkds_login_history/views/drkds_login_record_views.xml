<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_login_record_list" model="ir.ui.view">
        <field name="name">drkds.login.record.list</field>
        <field name="model">drkds.login.record</field>
        <field name="arch" type="xml">
            <list string="Login History" create="0" edit="0" default_order="event_date desc, id desc">
                <field name="event_date"/>
                <field name="user_id"/>
                <field name="login"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'success'"
                       decoration-warning="result == 'mfa_pending'"
                       decoration-danger="result == 'failed'"
                       decoration-info="result == 'logout'"/>
                <field name="ip_address"/>
                <field name="browser"/>
                <field name="os_name"/>
                <field name="user_agent" optional="hide"/>
                <field name="session_hash" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_login_record_form" model="ir.ui.view">
        <field name="name">drkds.login.record.form</field>
        <field name="model">drkds.login.record</field>
        <field name="arch" type="xml">
            <form string="Login Record" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Who">
                            <field name="user_id"/>
                            <field name="login"/>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'success'"
                                   decoration-warning="result == 'mfa_pending'"
                                   decoration-danger="result == 'failed'"
                                   decoration-info="result == 'logout'"/>
                            <field name="event_date"/>
                        </group>
                        <group string="From Where">
                            <field name="ip_address"/>
                            <field name="country_name"/>
                            <field name="browser"/>
                            <field name="os_name"/>
                            <field name="session_hash"/>
                        </group>
                    </group>
                    <group string="User Agent">
                        <field name="user_agent" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_login_record_search" model="ir.ui.view">
        <field name="name">drkds.login.record.search</field>
        <field name="model">drkds.login.record</field>
        <field name="arch" type="xml">
            <search string="Login History">
                <field name="login" filter_domain="['|', ('login', 'ilike', self), ('user_id', 'ilike', self)]" string="User or Login"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="browser"/>
                <!-- 'today' is resolved by the server in the user's timezone,
                     the same day the user form's "Failed Today" counts. -->
                <filter name="today" string="Today"
                        domain="[('event_date', '>=', 'today'), ('event_date', '&lt;', 'today +1d')]"/>
                <filter name="last_7_days" string="Last 7 Days"
                        domain="[('event_date', '>=', 'today -6d')]"/>
                <separator/>
                <filter name="failed" string="Failed" domain="[('result', '=', 'failed')]"/>
                <filter name="success" string="Success" domain="[('result', '=', 'success')]"/>
                <filter name="mfa_pending" string="2FA Pending" domain="[('result', '=', 'mfa_pending')]"/>
                <filter name="logout" string="Logout" domain="[('result', '=', 'logout')]"/>
                <separator/>
                <filter name="unknown_login" string="Unknown Login Name" domain="[('user_id', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="group_by_day" string="Day" context="{'group_by': 'event_date:day'}"/>
                    <filter name="group_by_ip" string="IP Address" context="{'group_by': 'ip_address'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_drkds_login_record_graph" model="ir.ui.view">
        <field name="name">drkds.login.record.graph</field>
        <field name="model">drkds.login.record</field>
        <field name="arch" type="xml">
            <graph string="Login Events per Day" type="bar" stacked="1" sample="1">
                <field name="event_date" interval="day" type="row"/>
                <field name="result" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_drkds_login_record" model="ir.actions.act_window">
        <field name="name">Login History</field>
        <field name="res_model">drkds.login.record</field>
        <field name="view_mode">list,graph,form</field>
        <field name="search_view_id" ref="view_drkds_login_record_search"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No login event recorded yet</p>
            <p>Every login attempt, successful or not, and every logout is listed here from now on.</p>
        </field>
    </record>

    <menuitem id="menu_drkds_login_record"
              name="Login History"
              parent="base.menu_users"
              action="action_drkds_login_record"
              groups="base.group_system"
              sequence="40"/>

</odoo>
