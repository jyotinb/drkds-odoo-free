<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_tds_ytd_list" model="ir.ui.view">
        <field name="name">drkds.tds.ytd.list</field>
        <field name="model">drkds.tds.ytd</field>
        <field name="arch" type="xml">
            <list string="TDS Year to Date" create="false" edit="false"
                  decoration-warning="over_threshold">
                <field name="financial_year"/>
                <field name="partner_id"/>
                <field name="pan_entity_id" optional="show"/>
                <field name="section_id"/>
                <field name="base_amount" sum="Billed"/>
                <field name="aggregate_limit" optional="show"/>
                <field name="over_threshold" optional="show"/>
                <field name="deducted_amount" sum="Deducted"/>
                <field name="bill_count" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_bills" type="object" string="Bills"
                        icon="fa-list" title="Show the bills behind this total"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_tds_ytd_search" model="ir.ui.view">
        <field name="name">drkds.tds.ytd.search</field>
        <field name="model">drkds.tds.ytd</field>
        <field name="arch" type="xml">
            <search string="TDS Year to Date">
                <field name="partner_id"/>
                <field name="section_id"/>
                <field name="financial_year"/>
                <filter name="over" string="Over Annual Threshold"
                        domain="[('over_threshold', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_section" string="Section" context="{'group_by': 'section_id'}"/>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_year" string="Financial Year" context="{'group_by': 'financial_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_drkds_tds_ytd" model="ir.actions.act_window">
        <field name="name">TDS Year to Date</field>
        <field name="res_model">drkds.tds.ytd</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_section': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing billed under a TDS section yet</p>
            <p>
                What each vendor has been billed under each section since 1 April,
                against the section's annual threshold, next to what has actually
                been deducted. The localisation works this figure out to decide
                whether to warn you on a bill; this is the same figure, in a list
                you can read before the quarter closes.
            </p>
        </field>
    </record>

</odoo>
