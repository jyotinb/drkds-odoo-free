<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_tds_rate_map_list" model="ir.ui.view">
        <field name="name">drkds.tds.rate.map.list</field>
        <field name="model">drkds.tds.rate.map</field>
        <field name="arch" type="xml">
            <list string="TDS Section Rate Map" editable="bottom">
                <field name="section_id"/>
                <field name="normal_tax_id"/>
                <field name="higher_tax_id"/>
                <field name="lower_tax_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_tds_rate_map_form" model="ir.ui.view">
        <field name="name">drkds.tds.rate.map.form</field>
        <field name="model">drkds.tds.rate.map</field>
        <field name="arch" type="xml">
            <form string="TDS Section Rate Map">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="section_id" options="{'no_create': True}"/></h1>
                    </div>
                    <group>
                        <group string="Rates">
                            <field name="normal_tax_id" options="{'no_create': True}"/>
                            <field name="higher_tax_id" options="{'no_create': True}"/>
                            <field name="lower_tax_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Scope">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The sections, their thresholds and these rates all come from
                        Odoo's Indian localisation. This record only says which of the
                        section's rates to use when the vendor has a PAN and which to
                        use when they have not.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_tds_rate_map_search" model="ir.ui.view">
        <field name="name">drkds.tds.rate.map.search</field>
        <field name="model">drkds.tds.rate.map</field>
        <field name="arch" type="xml">
            <search string="TDS Section Rate Map">
                <field name="section_id"/>
                <filter name="no_higher" string="No Rate without PAN"
                        domain="[('higher_tax_id', '=', False)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_drkds_tds_rate_map" model="ir.actions.act_window">
        <field name="name">TDS Section Rates</field>
        <field name="res_model">drkds.tds.rate.map</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map a TDS section to its rates</p>
            <p>
                Pick a section, and the rate without PAN is proposed for you: it is
                the steepest rate the localisation ships for that section, which is
                what section 206AA asks for. The normal rate is yours to choose,
                because a section such as 194C carries one rate for an individual
                contractor and another for a company.
            </p>
            <p>
                Once a section is mapped, the TDS wizard selects the rate by itself.
            </p>
        </field>
    </record>

</odoo>
