<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_drkds_ticketing" model="res.groups.privilege">
        <field name="name">Support Tickets</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_ticket_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_drkds_ticketing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Works on the tickets of their own teams.</field>
    </record>

    <record id="group_ticket_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_drkds_ticketing"/>
        <field name="implied_ids" eval="[(4, ref('group_ticket_user'))]"/>
        <field name="comment">Sees every ticket and maintains teams and stages.</field>
    </record>

</odoo>
