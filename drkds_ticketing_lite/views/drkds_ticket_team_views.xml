<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_ticket_team_list" model="ir.ui.view">
        <field name="name">drkds.ticket.team.list</field>
        <field name="model">drkds.ticket.team</field>
        <field name="arch" type="xml">
            <list string="Teams">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_user_id"/>
                <field name="member_ids" widget="many2many_tags" optional="show"/>
                <field name="open_ticket_count" string="Open"/>
                <field name="ticket_count" string="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_ticket_team_form" model="ir.ui.view">
        <field name="name">drkds.ticket.team.form</field>
        <field name="model">drkds.ticket.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object"
                                class="oe_stat_button" icon="fa-life-ring">
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Level 1 Support"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_user_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Members">
                        <field name="member_ids" nolabel="1" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_ticket_team_search" model="ir.ui.view">
        <field name="name">drkds.ticket.team.search</field>
        <field name="model">drkds.ticket.team</field>
        <field name="arch" type="xml">
            <search string="Teams">
                <field name="name"/>
                <field name="member_ids"/>
                <filter name="my_teams" string="My Teams"
                        domain="[('member_ids', 'in', uid)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_drkds_ticket_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">drkds.ticket.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a support team</p>
            <p>
                A team groups the people who answer a class of requests. Members see the
                team's tickets, and the default assignee picks up anything created
                without an owner.
            </p>
        </field>
    </record>

</odoo>
