<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_drkds_asset" model="res.groups.privilege">
        <field name="name">Fixed Assets</field>
        <field name="description">Access to the fixed asset register.</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_drkds_asset_user" model="res.groups">
        <field name="name">Reader</field>
        <field name="privilege_id" ref="privilege_drkds_asset"/>
        <field name="comment">Can consult the asset register and print it.</field>
    </record>

    <record id="group_drkds_asset_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_drkds_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_drkds_asset_user'))]"/>
        <field name="comment">Can record assets, categories and disposals.</field>
        <!-- The installing administrator gets the manager group, so the app
             works the moment it is installed rather than raising an access
             error on the first click. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_drkds_asset_company" model="ir.rule">
        <field name="name">Fixed asset: multi-company</field>
        <field name="model_id" ref="model_drkds_asset"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_drkds_asset_category_company" model="ir.rule">
        <field name="name">Fixed asset category: multi-company</field>
        <field name="model_id" ref="model_drkds_asset_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_drkds_asset_line_company" model="ir.rule">
        <field name="name">Asset depreciation line: multi-company</field>
        <field name="model_id" ref="model_drkds_asset_depreciation_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
