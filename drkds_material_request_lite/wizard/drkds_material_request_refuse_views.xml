<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drkds_material_request_refuse_form" model="ir.ui.view">
        <field name="name">drkds.material.request.refuse.form</field>
        <field name="model">drkds.material.request.refuse</field>
        <field name="arch" type="xml">
            <form string="Refuse Material Request">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="reason" nolabel="1"
                           placeholder="Explain why this request is turned down. The requester will see this."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Refuse" type="object" class="btn-danger"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
