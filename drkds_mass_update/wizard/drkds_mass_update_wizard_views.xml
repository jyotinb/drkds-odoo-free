<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_mass_update_wizard_form" model="ir.ui.view">
        <field name="name">drkds.mass.update.wizard.form</field>
        <field name="model">drkds.mass.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Update">
                <field name="state" invisible="1"/>
                <!-- state: shows one step at a time -->
                <field name="model_name" invisible="1"/>
                <!-- model_name: kept with the record so each step reads the same model -->
                <field name="relation_model" invisible="1"/>
                <!-- relation_model: target model of the record picker (value_record_id) -->
                <field name="field_type" invisible="1"/>
                <!-- field_type: shows the value input matching the field -->
                <field name="field_required" invisible="1"/>
                <!-- field_required: hides Set Empty on a required field -->
                <field name="res_ids" invisible="1"/>
                <!-- res_ids: the selection, kept with the record between steps -->
                <!-- Step 1: which field -->
                <div invisible="state != 'field'">
                    <group>
                        <group>
                            <field name="model_description"/>
                            <field name="record_count"/>
                        </group>
                        <group>
                            <field name="field_choice_id" placeholder="Type to search a field"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Only fields you can write are listed: stored, editable fields of a
                        supported type. Type part of the field's name to find it, then press
                        Next to enter the value.
                    </div>
                </div>
                <!-- Step 2: which value -->
                <div invisible="state != 'value'">
                    <group>
                        <group>
                            <field name="model_description"/>
                            <field name="record_count"/>
                        </group>
                        <group>
                            <field name="field_label"/>
                            <!-- A required field cannot be emptied; a required
                                 number or yes/no can still be set to 0 / No. -->
                            <field name="set_empty"
                                   invisible="field_required and field_type not in ('boolean', 'integer', 'float', 'monetary')"/>
                        </group>
                    </group>
                    <group string="New Value" invisible="set_empty">
                        <field name="value_char" invisible="field_type != 'char'"/>
                        <field name="value_text" invisible="field_type != 'text'"/>
                        <field name="value_html" invisible="field_type != 'html'"/>
                        <field name="value_integer" invisible="field_type != 'integer'"/>
                        <field name="value_float" invisible="field_type not in ('float', 'monetary')"/>
                        <field name="value_boolean" invisible="field_type != 'boolean'"/>
                        <field name="value_date" invisible="field_type != 'date'"/>
                        <field name="value_datetime" invisible="field_type != 'datetime'"/>
                        <field name="value_choice_id" invisible="field_type != 'selection'"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="value_record_id" widget="many2one_reference"
                               invisible="field_type not in ('many2one', 'many2many')"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="field_type != 'many2many' or set_empty">
                        The chosen record is added to the existing tags of every selected
                        record. Tick Set Empty to remove all tags instead.
                    </div>
                    <div class="alert alert-warning" role="alert">
                        The change is applied as you, with your access rights, and cannot
                        be undone in one step. Records you are not allowed to change are
                        reported and left as they are.
                    </div>
                </div>
                <!-- Step 3: the result -->
                <div invisible="state != 'done'">
                    <group>
                        <group>
                            <field name="model_description"/>
                            <field name="field_label"/>
                        </group>
                        <group>
                            <field name="updated_count"/>
                            <field name="failed_count"/>
                        </group>
                    </group>
                    <field name="result_summary" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_next" type="object" string="Next"
                            class="btn-primary" invisible="state != 'field'"/>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary" invisible="state != 'value'"
                            confirm="Apply this value to every selected record?"/>
                    <button name="action_back" type="object" string="Back"
                            class="btn-secondary" invisible="state != 'value'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"
                            invisible="state == 'done'"/>
                    <button string="Close" special="cancel" class="btn-primary"
                            invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- The choice lines are only seen through the wizard's two pickers;
         this list and search serve their "Search More..." dialog. -->
    <record id="view_drkds_mass_update_field_choice_list" model="ir.ui.view">
        <field name="name">drkds.mass.update.field.choice.list</field>
        <field name="model">drkds.mass.update.field.choice</field>
        <field name="arch" type="xml">
            <list string="Choices" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="field_type" optional="show"/>
                <field name="relation_model" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_mass_update_field_choice_search" model="ir.ui.view">
        <field name="name">drkds.mass.update.field.choice.search</field>
        <field name="model">drkds.mass.update.field.choice</field>
        <field name="arch" type="xml">
            <search string="Choices">
                <field name="name" string="Label or Technical Name"
                       filter_domain="['|', ('name', 'ilike', self), ('technical_name', 'ilike', self)]"/>
                <field name="field_type"/>
                <filter name="group_by_field_type" string="Field Type"
                        context="{'group_by': 'field_type'}"/>
            </search>
        </field>
    </record>

</odoo>
