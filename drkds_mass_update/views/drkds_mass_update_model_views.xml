<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_drkds_mass_update_model_list" model="ir.ui.view">
        <field name="name">drkds.mass.update.model.list</field>
        <field name="model">drkds.mass.update.model</field>
        <field name="arch" type="xml">
            <list string="Mass Update Models" editable="bottom">
                <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="model_name" readonly="1"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="server_action_id" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_drkds_mass_update_model_form" model="ir.ui.view">
        <field name="name">drkds.mass.update.model.form</field>
        <field name="model">drkds.mass.update.model</field>
        <field name="arch" type="xml">
            <form string="Mass Update Model">
                <header>
                    <button name="action_enable" type="object" string="Enable"
                            class="btn-primary" invisible="enabled"/>
                    <button name="action_disable" type="object" string="Disable"
                            class="btn-secondary" invisible="not enabled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="model_id" placeholder="Model"
                                   options="{'no_create': True, 'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name"/>
                            <field name="enabled"/>
                        </group>
                        <group>
                            <field name="server_action_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        While enabled, the list view of this model carries a
                        <b>Mass update</b> entry in its Actions menu for every internal
                        user. The user's own access rights and the model's record rules
                        decide which records they can actually change.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_drkds_mass_update_model_search" model="ir.ui.view">
        <field name="name">drkds.mass.update.model.search</field>
        <field name="model">drkds.mass.update.model</field>
        <field name="arch" type="xml">
            <search string="Mass Update Models">
                <field name="model_id"/>
                <field name="model_name"/>
                <filter name="filter_enabled" string="Enabled"
                        domain="[('enabled', '=', True)]"/>
                <filter name="filter_disabled" string="Disabled"
                        domain="[('enabled', '=', False)]"/>
                <separator/>
                <filter name="group_by_enabled" string="Enabled"
                        context="{'group_by': 'enabled'}"/>
            </search>
        </field>
    </record>

    <record id="action_drkds_mass_update_model" model="ir.actions.act_window">
        <field name="name">Mass Update</field>
        <field name="res_model">drkds.mass.update.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drkds_mass_update_model_search"/>
        <field name="context">{'search_default_filter_enabled': 1}</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No model enabled for mass update yet.</p>
            <p>Add a model to put a <b>Mass update</b> entry in the Actions menu of
            its list view. Users select records there, pick a field and a value,
            and every record they are allowed to change is updated at once.</p>
        </field>
    </record>

    <menuitem id="menu_drkds_mass_update"
              name="Mass Update"
              parent="base.menu_custom"
              action="action_drkds_mass_update_model"
              groups="base.group_system"
              sequence="56"/>

</odoo>
