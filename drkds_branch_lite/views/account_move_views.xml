<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="drkds_branch_view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.drkds.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="drkds_branch_id" options="{'no_create': True}"
                       readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

    <record id="drkds_branch_view_invoice_list" model="ir.ui.view">
        <field name="name">account.move.list.drkds.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field name="drkds_branch_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="drkds_branch_view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.move.search.drkds.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="drkds_branch_id" string="Branch"/>
            </field>
            <filter name="group_by_company" position="after">
                <filter name="drkds_group_branch" string="Branch"
                        context="{'group_by': 'drkds_branch_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
