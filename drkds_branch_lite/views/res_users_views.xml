<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="drkds_branch_view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.drkds.lite.branch</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <field name="drkds_branch_id"
                       groups="drkds_branch_lite.group_drkds_branch_manager"/>
                <field name="drkds_branch_ids" widget="many2many_tags"
                       groups="drkds_branch_lite.group_drkds_branch_manager"/>
            </group>
        </field>
    </record>

</odoo>
