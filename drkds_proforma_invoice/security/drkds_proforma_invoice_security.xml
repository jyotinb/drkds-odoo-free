<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_drkds_proforma_invoice_company" model="ir.rule">
            <field name="name">Proforma Invoice: multi-company</field>
            <field name="model_id" ref="model_drkds_proforma_invoice"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!--
            A portal user reads only proformas addressed to their own commercial
            entity, and only those that have actually been issued. Drafts stay
            internal.
        -->
        <record id="rule_drkds_proforma_invoice_portal" model="ir.rule">
            <field name="name">Proforma Invoice: portal customer</field>
            <field name="model_id" ref="model_drkds_proforma_invoice"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('state', '!=', 'draft'), ('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
