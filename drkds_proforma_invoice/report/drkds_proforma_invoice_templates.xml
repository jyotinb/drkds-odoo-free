<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The document body. Shared by the PDF and by the portal page so a
        customer never sees two different versions of the same figures.
    -->
    <template id="drkds_proforma_invoice_document_body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="mb-0" style="letter-spacing:1px;">PROFORMA INVOICE</h2>
                <div class="text-muted">Not a tax invoice</div>
            </div>
            <div class="text-end">
                <div><strong t-out="doc.name">PRO/2026/00001</strong></div>
                <div t-field="doc.date"/>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <strong>Billed to</strong>
                <div t-field="doc.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email", "vat"], "no_marker": true}'/>
            </div>
            <div class="col-6 text-end">
                <table class="table table-sm table-borderless ms-auto" style="width:auto;">
                    <tr t-if="doc.validity_date">
                        <td class="text-muted pe-3">Valid until</td>
                        <td class="text-end"><span t-field="doc.validity_date"/></td>
                    </tr>
                    <tr t-if="doc.sale_order_id">
                        <td class="text-muted pe-3">Source quotation</td>
                        <td class="text-end"><span t-field="doc.sale_order_id.name"/></td>
                    </tr>
                    <tr t-if="doc.source_move_id">
                        <td class="text-muted pe-3">Source draft invoice</td>
                        <td class="text-end"><span t-field="doc.source_move_id.name"/></td>
                    </tr>
                    <tr>
                        <td class="text-muted pe-3">Currency</td>
                        <td class="text-end"><span t-field="doc.currency_id.name"/></td>
                    </tr>
                </table>
            </div>
        </div>

        <table class="table table-sm o_main_table">
            <thead>
                <tr>
                    <th class="text-start">Description</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end" t-if="any(l.discount for l in doc.line_ids)">Disc. %</th>
                    <th class="text-start">Taxes</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="show_discount" t-value="any(l.discount for l in doc.line_ids)"/>
                <t t-foreach="doc.line_ids" t-as="line">
                    <tr t-if="not line.display_type">
                        <td><span t-field="line.name"/></td>
                        <td class="text-end">
                            <span t-field="line.quantity"/>
                            <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                        </td>
                        <td class="text-end"><span t-field="line.price_unit"/></td>
                        <td class="text-end" t-if="show_discount"><span t-field="line.discount"/></td>
                        <td class="text-start">
                            <span t-out="', '.join(t.name for t in line.tax_ids)"/>
                        </td>
                        <td class="text-end">
                            <span t-field="line.price_subtotal"
                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                        </td>
                    </tr>
                    <tr t-if="line.display_type == 'line_section'" class="bg-200">
                        <td colspan="99"><strong t-field="line.name"/></td>
                    </tr>
                    <tr t-if="line.display_type == 'line_note'">
                        <td colspan="99"><em t-field="line.name"/></td>
                    </tr>
                </t>
            </tbody>
        </table>

        <div class="clearfix">
            <div id="total" class="row">
                <div t-attf-class="ms-auto col-5">
                    <table class="table table-sm">
                        <tr>
                            <td>Untaxed Amount</td>
                            <td class="text-end">
                                <span t-field="doc.amount_untaxed"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                        <tr>
                            <td>Taxes <small class="text-muted">(indicative)</small></td>
                            <td class="text-end">
                                <span t-field="doc.amount_tax"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="border-black o_total">
                            <td><strong>Total</strong></td>
                            <td class="text-end">
                                <strong t-field="doc.amount_total"
                                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div t-if="doc.terms" class="mt-3">
            <strong>Terms</strong>
            <p class="mb-1" t-field="doc.terms"/>
        </div>
        <div t-if="doc.note" class="mt-2">
            <p class="mb-1" t-field="doc.note"/>
        </div>

        <div class="mt-4 p-2 border border-2 border-dark">
            <strong>Proforma invoice - not a tax invoice.</strong>
            <span t-field="doc.disclaimer"/>
        </div>
    </template>

    <template id="report_drkds_proforma_invoice_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang or doc.env.context.get('lang'))"/>
        <t t-call="web.external_layout">
            <div class="page">
                <t t-call="drkds_proforma_invoice.drkds_proforma_invoice_document_body"/>
            </div>
        </t>
    </template>

    <template id="report_drkds_proforma_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="drkds_proforma_invoice.report_drkds_proforma_invoice_document"/>
            </t>
        </t>
    </template>

</odoo>
