<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            A sequence of its own. This is the whole point: a proforma number
            is drawn from here and never from an invoice journal sequence, so
            issuing a proforma cannot consume, reserve or skip an invoice
            number.
        -->
        <record id="seq_drkds_proforma_invoice" model="ir.sequence">
            <field name="name">Proforma Invoice</field>
            <field name="code">drkds.proforma.invoice</field>
            <field name="prefix">PRO/%(range_year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
