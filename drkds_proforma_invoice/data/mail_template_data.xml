<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_drkds_proforma_invoice" model="mail.template">
            <field name="name">Proforma Invoice: Send</field>
            <field name="model_id" ref="drkds_proforma_invoice.model_drkds_proforma_invoice"/>
            <field name="subject">{{ object.company_id.name }} Proforma Invoice {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or '') }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent to the customer with the proforma invoice PDF attached.</field>
            <field name="report_template_ids" eval="[(6, 0, [ref('drkds_proforma_invoice.action_report_drkds_proforma_invoice')])]"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin:0px;padding:0px;font-size:13px;">
    <p>Dear <t t-out="object.partner_id.name or ''">Customer</t>,</p>
    <p>
        Please find attached our proforma invoice
        <strong t-out="object.name or ''">PRO/2026/00001</strong>
        for <strong t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 0.00</strong>.
    </p>
    <p t-if="object.validity_date">
        The prices quoted are held until
        <strong t-out="format_date(object.validity_date) or ''">2026-12-31</strong>.
    </p>
    <p>
        This document is a proforma invoice. It is not a tax invoice and it
        does not confer input tax credit. A tax invoice follows once the
        supply is made.
    </p>
    <p>Kind regards,<br/><t t-out="object.user_id.name or object.company_id.name or ''">Sales</t></p>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
        </record>

    </data>
</odoo>
