<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_drkds_proforma" model="ir.ui.view">
        <field name="name">res.config.settings.form.drkds.proforma</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="drkds_proforma_disclaimer_setting"
                         string="Proforma Disclaimer"
                         help="Statement printed on every proforma invoice PDF.">
                    <field name="drkds_proforma_disclaimer"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
