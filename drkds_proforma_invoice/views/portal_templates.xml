<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone portal page for one proforma invoice. -->
    <template id="portal_drkds_proforma_page" name="Proforma Invoice">
        <t t-call="portal.portal_layout">
            <t t-set="doc" t-value="proforma"/>
            <div class="row mt-3 mb-3">
                <div class="col-12">
                    <a class="btn btn-secondary btn-sm float-end"
                       t-attf-href="/my/proforma/#{proforma.id}?report_type=pdf&amp;download=true#{'&amp;access_token=%s' % token if token else ''}">
                        <i class="fa fa-download"/> Download
                    </a>
                </div>
            </div>
            <div class="o_portal_html_view bg-white p-3 border rounded">
                <t t-call="drkds_proforma_invoice.drkds_proforma_invoice_document_body"/>
            </div>
        </t>
    </template>

    <!-- Link the proformas from the quotation the customer already sees. -->
    <template id="portal_drkds_proforma_in_sale_order"
              inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='introduction']" position="after">
            <t t-set="drkds_proformas"
               t-value="sale_order.drkds_proforma_ids.filtered(lambda p: p.state != 'draft')"/>
            <div t-if="report_type == 'html' and drkds_proformas" class="mb-3"
                 id="drkds_proforma_block">
                <h5 class="mb-1">Proforma Invoices</h5>
                <hr class="mt-1 mb-2"/>
                <t t-foreach="drkds_proformas" t-as="drkds_proforma">
                    <div class="d-flex justify-content-between align-items-center">
                        <a t-attf-href="/my/proforma/#{drkds_proforma.id}#{'?access_token=%s' % sale_order.access_token if sale_order.access_token else ''}">
                            <span t-out="drkds_proforma.name"/>
                        </a>
                        <span class="text-muted small">
                            <span t-field="drkds_proforma.date"/>
                        </span>
                    </div>
                </t>
                <div class="small text-muted mt-1">
                    A proforma invoice is not a tax invoice.
                </div>
            </div>
        </xpath>
    </template>

</odoo>
